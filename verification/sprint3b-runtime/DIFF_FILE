+  let worker = null;
+  function startWorker() {
+    if (worker) return worker;
+    worker = setInterval(() => { processPending().catch(() => {}); }, Math.max(250, Number(pollIntervalMs) || 1000));
+    worker.unref?.();
+    return worker;
+  }
