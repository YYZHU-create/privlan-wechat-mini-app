 .page-nav-entry .page-nav-more { position: absolute; top: 2px; right: 2px; z-index: 1; min-width: 40px; min-height: 40px; opacity: 1; border: 1px solid transparent; border-radius: 8px; color: var(--ui-text-secondary); }
