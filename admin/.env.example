# ATELIER OS SaaS runtime
NODE_ENV=development
PORT=3456
PRIVLAN_ADMIN_HOST=127.0.0.1
# Required whenever PRIVLAN_ADMIN_HOST is not a loopback address.
PRIVLAN_ADMIN_TOKEN=

# Operator control plane. Always set a strong password outside local development.
ATELIER_OPS_EMAIL=ops-admin@localhost
ATELIER_OPS_PASSWORD=

# Production PostgreSQL. Set ATELIER_AUTO_MIGRATE=1 only for a controlled
# single-instance migration step; use a dedicated release job at scale.
DATABASE_URL=
ATELIER_AUTO_MIGRATE=0

# HMAC pepper for one-time license code hashes. Use at least 32 random characters.
ATELIER_LICENSE_PEPPER=

# S2S credential accepted only by the three mini-program appointment gateway
# routes. Generate at least 32 random characters and set the same value only in
# the appointment cloud functions. Never generate it into mini-program source.
ATELIER_APPOINTMENT_GATEWAY_TOKEN=

# Independent HMAC key for irreversible WeChat OpenID identity hashes. Use at
# least 32 random bytes and do not reuse the license pepper or master key.
ATELIER_OPENID_HASH_KEY=

# Reserved for future signed session payloads. Current merchant sessions use
# random opaque tokens with server-side hashes and do not depend on this value.
SESSION_SECRET=

# Optional isolated storage paths for automated tests and temporary environments.
# ATELIER_STATE_PATH=C:\\path\\to\\temporary-saas-state.json
# PRIVLAN_CONFIG_PATH=C:\\path\\to\\temporary-config.json
# PRIVLAN_IMAGES_DIR=C:\\path\\to\\temporary-images
# ATELIER_MASTER_KEY_PATH=C:\\path\\to\\temporary-master-key
# 32 random bytes encoded as Base64. Production should use Tencent Cloud KMS instead.
ATELIER_MASTER_KEY=

# Legacy PRIVLAN import. The importer stops before any database write when these
# credentials are absent. Remove them after the verified one-time import.
PRIVLAN_LEGACY_OWNER_LOGIN=
PRIVLAN_LEGACY_OWNER_PASSWORD=
PRIVLAN_LEGACY_FALLBACK=0

# The appointment cloud functions default to PostgreSQL. Set "feishu" only for
# an explicit legacy rollback window; there is no automatic fallback.
ATELIER_APPOINTMENT_BACKEND=postgres

# SaaS runtime must not commit tenant content into the source repository.
PRIVLAN_DISABLE_GIT_SYNC=1

# Optional one-time migration from the former platform-wide DeepSeek configuration.
# After startup migrates this connection, remove these variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Deferred integrations. Do not commit real credentials.
REDIS_URL=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
WECHAT_OPEN_PLATFORM_APP_ID=
WECHAT_PAY_SERVICE_PROVIDER_MCH_ID=
