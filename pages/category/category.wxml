<view class="builder-page">
  <view class="builder-nav" style="padding-top:{{navPadTop}}px">
    
  </view>
  <view class="builder-content"><view class="builder-text builder-block" style="background:transparent;color:#f0f0f0;font-family:&quot;Songti SC&quot;,&quot;STSong&quot;,&quot;Noto Serif SC&quot;,serif;font-size:18px;font-weight:400;text-align:center;letter-spacing:0px;line-height:1.5;padding:22px 22px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px"><view class="builder-text-title serif">??</view><view class="builder-text-copy">???????</view></view>
<scroll-view scroll-x class="builder-categories builder-block" style="background:transparent;color:#f0f0f0;font-family:-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;font-size:10px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:17px 14px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px" enable-flex>
  <view wx:for="{{block1}}" wx:key="id" class="builder-category {{index === 0 ? 'on' : ''}}">{{item.name}}</view>
</scroll-view>
<view class="builder-products builder-block" style="background:transparent;color:#f0f0f0;font-family:-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;font-size:14px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:25px 15px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px">
  <view class="builder-section-head"><text class="serif">????</text><text class="builder-more">查看全部</text></view>
  <view class="builder-grid" style="grid-template-columns:repeat(2,1fr);gap:10px">
    <view wx:for="{{block2}}" wx:key="id" class="builder-product" data-id="{{item.id}}" bindtap="goDetail">
      <image class="builder-product-img" src="{{item.img}}" mode="aspectFill" />
      <view class="builder-product-name">{{item.name}}</view>
      <view class="builder-product-price">¥{{item.price}}</view>
    </view>
  </view>
</view></view>
  <service-fab enabled="{{serviceBot.enabled}}" icon="{{serviceBot.icon}}" size="{{serviceBot.size}}" right="{{serviceBot.right}}" bottom="{{serviceBot.bottom}}" />
</view>