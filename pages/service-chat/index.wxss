page { height: 100%; background: #f5f5f3; color: #171717; }
button::after { border: 0; }
.service-page { height: 100vh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: #f5f5f3; }
.service-header { padding: calc(env(safe-area-inset-top) + 22rpx) 32rpx 22rpx; display: flex; align-items: center; gap: 20rpx; background: #171717; color: #fff; }
.service-mark { width: 72rpx; height: 72rpx; display: grid; place-items: center; border: 1rpx solid #a16207; border-radius: 50%; color: #c9a97e; font: 500 34rpx Georgia, serif; }
.service-title { font-size: 28rpx; font-weight: 600; }
.service-status { margin-top: 6rpx; display: flex; align-items: center; gap: 8rpx; color: #bcb9b2; font-size: 20rpx; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #78a176; }
.message-list { min-height: 0; padding: 28rpx 28rpx 12rpx; box-sizing: border-box; }
.service-intro { margin: 12rpx 0 34rpx; color: #8b877f; font: 18rpx Georgia, serif; letter-spacing: 6rpx; text-align: center; }
.message-row { display: flex; margin-bottom: 22rpx; }
.message-row.user { justify-content: flex-end; }
.message-bubble { max-width: 78%; padding: 22rpx 24rpx; border: 1rpx solid #dfddd7; border-radius: 4rpx 20rpx 20rpx 20rpx; background: #fff; color: #2a2926; font-size: 26rpx; line-height: 1.65; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.user .message-bubble { border-color: #171717; border-radius: 20rpx 4rpx 20rpx 20rpx; background: #171717; color: #fff; }
.message-bubble.is-error { border-color: #d8a8a2; background: #fff7f5; color: #8d332a; }
.message-action { min-height: 88rpx; margin-top: 20rpx; padding: 0 24rpx; border-radius: 4rpx; background: #171717; color: #fff; font-size: 24rpx; line-height: 88rpx; }
.message-action.muted { border: 1rpx solid #c9c5bb; background: #fff; color: #4f4c46; }
.measurement-list { margin-top: 20rpx; border-top: 1rpx solid #e5e2dc; }
.measurement-list view { min-height: 64rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #ece9e3; }
.measurement-list text { color: #77736b; }
.measurement-list .metric-value { color: #171717; font-weight: 600; }
.typing { display: flex; gap: 8rpx; padding: 24rpx 28rpx; border-radius: 4rpx 20rpx 20rpx 20rpx; background: #fff; }
.typing view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #a16207; animation: typing 1.1s infinite ease-in-out; }
.typing view:nth-child(2) { animation-delay: .12s; }.typing view:nth-child(3) { animation-delay: .24s; }
.message-end { height: 18rpx; }
.composer-panel { padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx); border-top: 1rpx solid #dedbd4; background: rgba(255,255,255,.98); }
.quick-prompts { width: 100%; margin-bottom: 14rpx; white-space: nowrap; }
.quick-prompts button { display: inline-flex; align-items: center; min-height: 72rpx; margin-right: 12rpx; padding: 0 22rpx; border: 1rpx solid #cbc7be; border-radius: 36rpx; background: #fff; color: #34312d; font-size: 22rpx; line-height: 72rpx; }
.composer { display: grid; grid-template-columns: minmax(0,1fr) 108rpx; gap: 12rpx; }
.composer input { min-height: 88rpx; padding: 0 24rpx; border: 1rpx solid #cbc7be; border-radius: 4rpx; background: #f8f8f6; font-size: 26rpx; box-sizing: border-box; }
.send-button { min-height: 88rpx; padding: 0; border-radius: 4rpx; background: #a16207; color: #fff; font-size: 24rpx; line-height: 88rpx; }
.send-button[disabled] { background: #d6d2ca; color: #89857d; }
.privacy-note { margin-top: 12rpx; color: #8b877f; font-size: 18rpx; text-align: center; }
.modal-layer { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(0,0,0,.54); }
.auth-sheet { width: 100%; padding: 12rpx 32rpx calc(env(safe-area-inset-bottom) + 34rpx); border-radius: 24rpx 24rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-handle { width: 64rpx; height: 6rpx; margin: 0 auto 24rpx; border-radius: 6rpx; background: #d6d3cc; }
.sheet-head { display: flex; justify-content: space-between; gap: 24rpx; margin-bottom: 28rpx; }
.sheet-title { font-size: 32rpx; font-weight: 650; }.sheet-copy { margin-top: 8rpx; color: #77736b; font-size: 22rpx; line-height: 1.55; }
.sheet-head button { width: 88rpx; height: 88rpx; padding: 0; border-radius: 50%; background: #f2f1ed; color: #504d47; font-size: 40rpx; line-height: 88rpx; }
.form-field { display: block; margin-bottom: 22rpx; }.form-field text { display: block; margin-bottom: 10rpx; font-size: 22rpx; font-weight: 600; }
.form-field input { min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #c9c5bc; border-radius: 4rpx; background: #fafaf8; box-sizing: border-box; }
.form-error { margin: -6rpx 0 18rpx; color: #a33b31; font-size: 22rpx; }
.primary-button { min-height: 92rpx; border-radius: 4rpx; background: #171717; color: #fff; font-size: 26rpx; line-height: 92rpx; }
.auth-phone-copy { margin-bottom: 24rpx; color: #5e5a53; font-size: 24rpx; line-height: 1.65; }
@keyframes typing { 0%,60%,100% { opacity:.28; transform:translateY(0); } 30% { opacity:1; transform:translateY(-5rpx); } }
@media (prefers-reduced-motion: reduce) { .typing view { animation: none; opacity: .65; } }
