<view class="appointments-page">
  <view class="appointments-hero"><text>PRIVLAN APPOINTMENTS</text><view>我的预约</view><text class="hero-copy">查看即将到店的服务时间，并管理微信提醒。</text></view>
  <view wx:if="{{loading}}" class="data-notice">正在同步云端预约…</view>
  <view wx:if="{{cacheOnly}}" class="data-notice warning">当前显示缓存数据。{{loadError}}</view>
  <view wx:if="{{!upcoming.length && !history.length}}" class="empty-card"><view class="empty-title">还没有预约记录</view><view class="empty-copy">完成一次到店预约后，时间和门店会显示在这里。</view><button bindtap="createAppointment">预约专属服务</button></view>
  <view wx:if="{{upcoming.length}}" class="section"><view class="section-title">即将到店</view><view wx:for="{{upcoming}}" wx:key="number" class="appointment-card"><view class="card-head"><view><text class="date">{{item.date}}</text><text class="time">{{item.slotLabel}}</text></view><text class="status">{{item.status || '待确认'}}</text></view><view class="card-row"><text>门店</text><text>{{item.storeName}}</text></view><view class="card-row"><text>顾问</text><text>{{item.advisorName}}</text></view><view class="card-row"><text>预约编号</text><text>{{item.number}}</text></view><view class="card-actions"><button data-number="{{item.number}}" bindtap="enableReminder" disabled="{{item.reminderEnabled}}">{{item.reminderEnabled ? '提醒已开启' : '开启预约提醒'}}</button><button bindtap="openService">联系客服</button></view></view></view>
  <view wx:if="{{history.length}}" class="section"><view class="section-title">历史预约</view><view wx:for="{{history}}" wx:key="number" class="appointment-card muted"><view class="card-head"><view><text class="date">{{item.date}}</text><text class="time">{{item.slotLabel}}</text></view><text class="status">{{item.status || '已完成'}}</text></view><view class="card-row"><text>门店</text><text>{{item.storeName}}</text></view><view class="card-row"><text>预约编号</text><text>{{item.number}}</text></view></view></view>
</view>
