page { min-height: 100%; background: #f5f4f1; color: #171717; font-size: 28rpx; line-height: 1.65; }
button::after { border: 0; }
.appointments-page { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.appointments-hero { padding: 54rpx 32rpx 42rpx; background: #171717; color: #fff; }
.appointments-hero > text:first-child { color: #c9a97e; font: 22rpx Georgia, serif; letter-spacing: 4rpx; }
.appointments-hero > view { margin-top: 16rpx; font: 500 42rpx/1.3 "Songti SC", serif; }
.hero-copy { display: block; margin-top: 12rpx; color: #c9c6bf; font-size: 26rpx; letter-spacing: 0; }
.data-notice { margin: 20rpx 24rpx 0; padding: 18rpx 22rpx; border: 1rpx solid #dedbd4; background: #fff; color: #5f5a53; font-size: 24rpx; }
.data-notice.warning { border-color: #d9c8a8; background: #fffaf0; color: #765225; }
.section { padding: 28rpx 24rpx 0; }
.section-title { margin-bottom: 16rpx; font-size: 34rpx; font-weight: 650; }
.appointment-card, .empty-card { margin-bottom: 18rpx; padding: 28rpx; border: 1rpx solid #dedbd4; border-radius: 8rpx; background: #fff; }
.card-head { display: flex; justify-content: space-between; gap: 20rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #e3e0da; }
.date, .time { display: block; }.date { font-size: 34rpx; font-weight: 650; }.time { margin-top: 6rpx; color: #6b665e; font-size: 26rpx; }.status { color: #765225; font-size: 24rpx; }
.card-row { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 18rpx; }.card-row text:first-child { color: #777169; }.card-row text:last-child { text-align: right; }
.card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 26rpx; }.card-actions button, .empty-card button { min-height: 88rpx; border: 1rpx solid #171717; border-radius: 4rpx; background: #171717; color: #fff; font-size: 26rpx; line-height: 88rpx; }.card-actions button:last-child { background: #fff; color: #171717; }.card-actions button[disabled] { border-color: #d4d0c8; background: #efede8; color: #817c73; }
.empty-card { margin: 28rpx 24rpx; text-align: center; }.empty-title { font-size: 34rpx; font-weight: 650; }.empty-copy { margin: 10rpx 0 26rpx; color: #6d6860; }.empty-card button { padding: 0 32rpx; }
.appointment-card.muted { opacity: .72; }
