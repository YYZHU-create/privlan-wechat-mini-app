<view class="appointment-page"><view wx:if="{{loadError}}" class="state-card error"><view>{{loadError}}</view><button bindtap="loadOptions">重新加载</button></view><view wx:elif="{{loading}}" class="state-card"><view class="loading-line"></view><view class="loading-line short"></view><text>正在读取可预约时间</text></view><view wx:else><view style="position:relative"><view class="appointment-hero" style="background:#171717;color:#ffffff;font-family:&amp;quot;Songti SC&amp;quot;,&amp;quot;STSong&amp;quot;,&amp;quot;Noto Serif SC&amp;quot;,serif;font-size:14px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:28px 24px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px;background-color:#171717"><view class="kicker">PRIVLAN APPOINTMENT</view><view class="title">??????</view><view class="copy">??????????????,??????????</view></view></view>
<view style="position:relative"><view class="appointment-form" style="background:#f4f3f0;color:#171717;font-family:-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;font-size:14px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:20px 16px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px">
  <view class="form-section"><view class="section-number">01</view><view class="section-title">预约人信息</view><label class="field"><text>姓名</text><input value="{{form.name}}" data-field="name" maxlength="24" bindinput="onInput" placeholder="请输入预约人姓名" /></label><view wx:if="{{errors.name}}" class="field-error">{{errors.name}}</view><label class="field"><text>联系电话</text><input value="{{form.phone}}" data-field="phone" type="number" maxlength="11" bindinput="onInput" placeholder="请输入手机号" /></label><view wx:if="{{errors.phone}}" class="field-error">{{errors.phone}}</view></view>
  
  <view class="form-section"><view class="section-number">03</view><view class="section-title">日期与时间</view><scroll-view class="date-strip" scroll-x enhanced show-scrollbar="{{false}}"><button wx:for="{{dates}}" wx:key="value" class="{{form.date === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectDate"><text>{{item.weekday}}</text><text class="date-day">{{item.day}}</text><text>{{item.month}}</text></button></scroll-view><view wx:if="{{!dates.length}}" class="empty-inline">当前门店暂无开放日期</view><view class="slot-grid"><button wx:for="{{slots}}" wx:key="id" class="{{form.slotId === item.id ? 'selected' : ''}}" disabled="{{item.available === false}}" data-value="{{item.id}}" bindtap="selectSlot">{{item.label}}</button></view><view wx:if="{{form.date && !slots.length}}" class="empty-inline">该日期暂无可预约时间</view><view wx:if="{{errors.slotId}}" class="field-error">{{errors.slotId}}</view></view>
  
</view></view>
<view style="position:relative"><view class="form-section notes-section" style="background:#ffffff;color:#171717;font-family:-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;font-size:14px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:20px 16px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px"><view class="section-number">05</view><view class="section-title">????</view><textarea value="{{form.notes}}" data-field="notes" maxlength="300" bindinput="onInput" placeholder="?????????????????" /><view class="counter">{{form.notes.length}} / 300</view></view></view>
<view style="position:relative"></view></view><view class="submit-bar" style="background:#ffffff;color:#171717;font-family:-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;font-size:14px;font-weight:400;text-align:left;letter-spacing:0px;line-height:1.5;padding:20px 16px;margin-top:0px;margin-bottom:0px;border:0px solid transparent;border-radius:0px"><button loading="{{submitting}}" disabled="{{loading || submitting || loadError}}" bindtap="submitAppointment">????</button></view><view wx:if="{{success}}" class="success-layer"><view class="success-card"><view class="success-mark">完成</view><view class="success-title">?????</view><view class="success-copy">???????????,????????</view><view class="success-detail"><text>预约编号</text><text class="detail-value">{{success.number}}</text><text>门店</text><text class="detail-value">{{success.storeName}}</text><text>时间</text><text class="detail-value">{{success.date}} {{success.slotLabel}}</text><text>顾问</text><text class="detail-value">{{success.advisorName}}</text></view><button bindtap="finish">完成</button></view></view><service-fab enabled="{{serviceBot.enabled}}" icon="{{serviceBot.icon}}" size="{{serviceBot.size}}" right="{{serviceBot.right}}" bottom="{{serviceBot.bottom}}" /></view>