page { min-height: 100%; background: #f4f3f0; color: #171717; }
button::after { border: 0; }
.appointment-page { min-height: 100vh; padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }
.appointment-hero { padding: 58rpx 32rpx 42rpx; background: #171717; color: #fff; }
.kicker { color: #c9a97e; font: 18rpx Georgia, serif; letter-spacing: 6rpx; }.title { margin-top: 18rpx; font: 500 46rpx "Songti SC", serif; }.copy { max-width: 620rpx; margin-top: 14rpx; color: #b8b5ae; font-size: 23rpx; line-height: 1.7; }
.appointment-form { padding: 24rpx; }.form-section { position: relative; margin-bottom: 20rpx; padding: 32rpx 28rpx; border: 1rpx solid #dfdcd5; border-radius: 8rpx; background: #fff; }
.section-number { color: #a16207; font: 18rpx Georgia, serif; letter-spacing: 3rpx; }.section-title { margin: 7rpx 0 26rpx; font-size: 30rpx; font-weight: 650; }
.field { display: block; margin-top: 22rpx; }.field text { display: block; margin-bottom: 10rpx; color: #555149; font-size: 22rpx; }.field input { min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #c9c5bc; border-radius: 4rpx; background: #fafaf8; box-sizing: border-box; }
.field-error { margin-top: 9rpx; color: #a33b31; font-size: 21rpx; }
.choice-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }.choice-grid button { min-height: 112rpx; padding: 18rpx; border: 1rpx solid #cbc7be; border-radius: 4rpx; background: #fff; color: #292824; text-align: left; }.choice-grid .option-name,.choice-grid text { display: block; }.choice-grid .option-name { margin-top: 0; color: #292824; font-size: 24rpx; font-weight: 600; }.choice-grid text { margin-top: 5rpx; color: #817d75; font-size: 19rpx; }.choice-grid button.selected { border-color: #a16207; box-shadow: inset 0 0 0 1rpx #a16207; }
.store-list { margin-top: 22rpx; display: grid; gap: 12rpx; }.store-list button { min-height: 104rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #d8d5ce; border-radius: 4rpx; background: #fff; text-align: left; }.store-list .option-name,.store-list text { display:block; }.store-list .option-name { color:#292824; font-size: 24rpx; font-weight:600; }.store-list text { margin-top: 6rpx; color: #7a766e; font-size: 20rpx; }.store-list .radio-mark { width: 24rpx; height: 24rpx; border: 2rpx solid #b9b5ad; border-radius: 50%; }.store-list button.selected { border-color: #a16207; }.store-list button.selected .radio-mark { border: 7rpx solid #a16207; box-sizing: border-box; }
.date-strip,.advisor-strip { width: 100%; white-space: nowrap; }.date-strip button { width: 114rpx; min-height: 142rpx; margin-right: 12rpx; padding: 14rpx 6rpx; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #d4d1ca; border-radius: 4rpx; background: #fff; color: #4b4842; }.date-strip text { color: #7c7870; font-size: 19rpx; }.date-strip .date-day { margin: 8rpx 0; color:#4b4842; font-size: 32rpx; font-weight:600; }.date-strip button.selected { border-color: #171717; background: #171717; color: #fff; }.date-strip button.selected text,.date-strip button.selected .date-day { color: #c9c5bc; }
.slot-grid { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }.slot-grid button { min-height: 82rpx; border: 1rpx solid #cbc7be; border-radius: 4rpx; background: #fff; color: #34312d; font-size: 22rpx; line-height: 82rpx; }.slot-grid button.selected { border-color: #a16207; background: #a16207; color: #fff; }.slot-grid button[disabled] { border-color: #e5e2dc; background: #f2f1ee; color: #aaa69e; }
.advisor-strip button { width: 184rpx; min-height: 232rpx; margin-right: 14rpx; padding: 18rpx 12rpx; display: inline-flex; flex-direction: column; align-items: center; border: 1rpx solid #d3d0c9; border-radius: 4rpx; background: #fff; color: #2f2d29; }.advisor-strip image { width: 100rpx; height: 100rpx; border-radius: 50%; background: #eceae5; }.advisor-strip .option-name { margin-top: 15rpx; color:#2f2d29; font-size: 23rpx; font-weight:600; }.advisor-strip text { margin-top: 5rpx; color: #817d75; font-size: 19rpx; }.advisor-strip button.selected { border-color: #a16207; box-shadow: inset 0 0 0 1rpx #a16207; }
.notes-section textarea { width: 100%; min-height: 180rpx; padding: 20rpx; border: 1rpx solid #c9c5bc; border-radius: 4rpx; background: #fafaf8; box-sizing: border-box; font-size: 24rpx; line-height: 1.6; }.counter { margin-top: 8rpx; color: #8a867e; font-size: 19rpx; text-align: right; }
.empty-inline { padding: 26rpx 0 4rpx; color: #7c7870; font-size: 22rpx; text-align: center; }
.state-card { margin: 28rpx 24rpx; padding: 48rpx 30rpx; border: 1rpx solid #dedbd4; border-radius: 8rpx; background: #fff; color: #68645d; text-align: center; }.state-card button { min-height: 84rpx; margin-top: 24rpx; padding: 0 34rpx; border: 1rpx solid #171717; border-radius: 4rpx; background: #171717; color: #fff; line-height: 84rpx; }.state-card.error { color:#913a31; }.loading-line { height: 22rpx; margin: 0 auto 14rpx; border-radius: 3rpx; background: #e5e2dc; animation: pulse 1.3s infinite; }.loading-line.short { width: 58%; margin-bottom: 30rpx; }
.submit-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx); border-top: 1rpx solid #d8d5ce; background: rgba(255,255,255,.97); }.submit-bar button { min-height: 92rpx; border-radius: 4rpx; background: #171717; color: #fff; font-size: 27rpx; letter-spacing: 3rpx; line-height: 92rpx; }.submit-bar button[disabled] { background: #aaa69e; }
.success-layer { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 36rpx; background: rgba(0,0,0,.58); }.success-card { width: 100%; max-width: 620rpx; padding: 48rpx 34rpx 32rpx; border-radius: 8rpx; background: #fff; text-align: center; box-sizing: border-box; }.success-mark { width: 88rpx; height: 88rpx; margin: 0 auto 20rpx; display: grid; place-items: center; border-radius: 50%; background: #171717; color: #c9a97e; font-size: 20rpx; font-weight:600; }.success-title { font-size: 34rpx; font-weight: 650; }.success-copy { margin-top: 10rpx; color: #77736b; font-size: 22rpx; line-height: 1.6; }.success-detail { margin: 28rpx 0; display: grid; grid-template-columns: auto 1fr; gap: 14rpx 22rpx; padding: 22rpx; background: #f5f4f1; text-align: left; }.success-detail text { color:#7d7971; }.success-detail .detail-value { color:#171717; font-weight:600; text-align:right; }.success-card button { min-height: 88rpx; border-radius: 4rpx; background:#171717;color:#fff;line-height:88rpx; }
@keyframes pulse { 50% { opacity:.45; } }
@media (prefers-reduced-motion: reduce) { .loading-line { animation:none; } }
