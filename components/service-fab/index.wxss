.service-fab {
  position: fixed;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 1rpx solid #a16207;
  border-radius: 50%;
  background: #171717;
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, .28);
  transition: opacity 160ms ease, box-shadow 160ms ease;
}

.service-fab::after { border: 0; }
.service-fab image { width: 52%; height: 52%; pointer-events: none; }
.service-fab--pressed { opacity: .78; }
.service-fab.is-dragging { box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, .38); transition: none; }
